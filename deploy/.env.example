# Copy to .env and edit. Used by deploy/docker-compose.yml and Caddyfile.
# The open-source Kortix app picks up its own settings from its project repo.

# Public hostname Caddy serves TLS for (must resolve to this machine)
KORTIX_DOMAIN=kortix.example.com

# Email Let's Encrypt uses for expiry notices
ACME_EMAIL=admin@example.com

# Postgres credentials for the Kortix database
POSTGRES_USER=kortix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kortix
