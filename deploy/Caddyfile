# Open-source Claude Cowork alternative - TLS reverse proxy for a self-hosted
# Kortix instance.
#
# Caddy provisions and renews Let's Encrypt certificates automatically. Put
# your domain in KORTIX_DOMAIN (see .env.example) and point the DNS A/AAAA
# record at this host before starting the stack.
#
# Docs: https://claudecoworkalternative.com/self-hosting.html

{
	email {$ACME_EMAIL:admin@example.com}
}

# Kortix web app + API
{$KORTIX_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
